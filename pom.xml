<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 消费入口统一走 z-boot-parent（1.0.19 起全组织口径）：继承第三方地板 z-boot-dependencies
         （156 条）+ import 兄弟仓版本权威 z-boot-fleet（163 条）+ Java 8 的 pluginManagement。
         以前的 parent 是 com.zifang:z-opc:1.0.0-SNAPSHOT —— 那个 pom 只存在于作者本机的 ~/.m2，
         而这里的 relativePath 指的 ../pom.xml 在本仓根本不存在（z-opc-foundation 下没有聚合 pom），
         换台机器连 pom 都读不动；对外发布的件靠 flatten oss 把 parent 剥掉了，所以 Central 消费者
         没受影响，但"源码能被别人构建"这件事一直是假的。
         relativePath 必须留空：parent 不在磁盘上，在 repo1。 -->
    <parent>
        <groupId>io.github.yuku123</groupId>
        <artifactId>z-boot-parent</artifactId>
        <version>1.0.21</version>
        <relativePath/>
    </parent>

    <artifactId>z-gw</artifactId>
    <groupId>io.github.yuku123</groupId>
    <version>1.0.6</version>
    <packaging>pom</packaging>

    <name>z-gw</name>
    <description>
        z-gw — 自研高性能 API Gateway，基于 Netty + Spring Boot 生态。
        设计融合: Spring Cloud Gateway 的 Route + Predicate + Filter 模型,
        Apache ShenYu 的 SPI 插件扩展, APISIX 的 radixtree 前缀树路由,
        Envoy 的 xDS 动态配置分发, 自研 Netty 异步非阻塞运行时。
        一行依赖即可在 Spring Boot 应用中嵌入企业级 API 网关。    </description>
    <url>https://github.com/yuku123/z-gw</url>
    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <developers>
        <developer>
            <id>yuku123</id>
            <name>yuku123</name>
            <email>1340947819@qq.com</email>
            <organization>z-team</organization>
            <organizationUrl>https://github.com/yuku123</organizationUrl>
            <timezone>+08:00</timezone>
            <roles>
                <role>owner</role>
            </roles>
        </developer>
    </developers>
    <scm>
        <connection>scm:git:https://github.com/yuku123/z-gw.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/yuku123/z-gw.git</developerConnection>
        <url>https://github.com/yuku123/z-gw</url>
        <tag>HEAD</tag>
    </scm>


    <modules>
        <module>z-gw-api</module>
        <module>z-gw-core</module>
        <module>z-gw-spring-boot-starter</module>
        <module>z-gw-admin</module>
        <!-- 临时排除 z-gw-examples（示例启动器，不是发布目标，留作仓库内 demo） -->
        <!-- <module>z-gw-examples</module> -->
    </modules>

    <properties>
        <!-- 版本口径由 parent 下发：netty 4.1.138.Final / log4j2 2.25.4 / z-util 1.0.13 三格
             与父链面值逐字相同（parent_preflight 对过），property 与对应的 DM 条目一起删掉。
             maven.compiler.source/target=8、sourceEncoding=UTF-8 同样由 parent 供。
             下面三个是**父链没有**的键，删了就当场换味，必须留：
               reactor 一族地板只到 spring-boot 2.7.18 的 3.4.34 / reactor-netty 不供；
               slf4j-api 地板跟 spring-boot 走 1.7.36，而本仓的绑定是 log4j-slf4j2-impl（要求 slf4j 2.x）。 -->
        <reactor-netty.version>1.1.13</reactor-netty.version>
        <projectreactor.version>3.6.10</projectreactor.version>
        <slf4j.version>2.0.9</slf4j.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- z-gw 自家 5 个 reactor 坐标钉 ${project.version}。这一格不是装饰：继承来的 DM 会
                 改写**传递依赖**的版本，而 fleet 里 z-gw 那一格钉的是 repo1 上的旧发布件 1.0.4
                 （z-cache 试点实测：不补这格，shade/打包会把旧字节码当 sibling 打进来）。
                 本仓当前版本与 fleet 面值刚好同值，所以补上之后 tree 不动；但它是"下次抬版本不踩坑"的前提。 -->
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-gw</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-gw-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-gw-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-gw-spring-boot-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-gw-admin</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- 原来这里 import 了 io.github.yuku123:z-boot-dependencies:1.0.17 —— 删了：
                 parent 已经带着同一坐标的 1.0.19，重复 import 只会造成 dm 打架。
                 净效果是地板抬了一格（1.0.17 → 1.0.19），漂出来的版本逐条记在提交说明里。 -->

            <!-- Netty / log4j2 的 managed 条目整批删掉：netty-bom 4.1.138.Final 与
                 log4j-api/core 2.25.4 都由地板直接下发，与本仓迁移前的面值同值。
                 ⚠ 例外是 log4j-slf4j2-impl：地板只钉了 log4j-slf4j-impl（slf4j 1.x 那支），
                 所以这一支由 z-gw-core 自己的字面 2.25.4 承载，不走 DM。 -->

            <!-- Reactor（可选 — 高级 HTTP 客户端/响应式出站）：地板跟 spring-boot 2.7.18 给
                 reactor-core 3.4.34、reactor-netty 不供 ⇒ 本仓自己钉，删掉即换味。 -->
            <dependency>
                <groupId>io.projectreactor.netty</groupId>
                <artifactId>reactor-netty</artifactId>
                <version>${reactor-netty.version}</version>
            </dependency>
            <dependency>
                <groupId>io.projectreactor</groupId>
                <artifactId>reactor-core</artifactId>
                <version>${projectreactor.version}</version>
            </dependency>

            <!-- Logging：slf4j-api 2.0.9 是本仓的刻意选择（地板跟 spring-boot 走 1.7.36，
                 而 log4j-slf4j2-impl 2.25.4 需要 slf4j 2.x）⇒ 这条直接 DM 必须留着压住。 -->
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-api</artifactId>
                <version>${slf4j.version}</version>
            </dependency>

            <!-- Micrometer — Prometheus 指标：地板（spring-boot 2.7.18）给 1.9.17，本仓要 1.12.13
                 ⇒ 直接条目压住（child 的直接 DM 优先于继承来的）。 -->
            <dependency>
                <groupId>io.micrometer</groupId>
                <artifactId>micrometer-core</artifactId>
                <version>1.12.13</version>
            </dependency>
            <dependency>
                <groupId>io.micrometer</groupId>
                <artifactId>micrometer-registry-prometheus</artifactId>
                <version>1.12.13</version>
            </dependency>

          <!-- 2026-09-29 撤掉过两格 io.prometheus:simpleclient / simpleclient_common（原钉 0.16.0）：
               那两格压的是地板 z-boot-dependencies 按坐标**直接**钉的 simpleclient=0.8.1（现读 1.0.19 发布件），
               而 micrometer-registry-prometheus 的 PrometheusMeterRegistry 要 io.prometheus.client.exemplars.ExemplarSampler
               （0.15.0 起才有）。地板 1.0.20 已把那一格删掉、让 micrometer 自己的 pom 说话 ⇒ 压法失去对象。
               净室实测（parent 1.0.21 + 空本地仓 + repo1-only）：树里落 simpleclient 0.15.0 + simpleclient_common 0.15.0
               + 三格 simpleclient_tracer_*，log4j-slf4j2-impl 0 命中。
             · org.yaml:snakeyaml 这一格**留着**：它压的是 floor import 的 spring-boot-dependencies:2.7.18 给
               的 1.30（CVE-2022-1471 口径），与地板这一刀无关。 -->
            <dependency>
                <groupId>org.yaml</groupId>
                <artifactId>snakeyaml</artifactId>
                <version>2.0</version>
            </dependency>

            <!-- Test -->
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>5.10.2</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.mockito</groupId>
                <artifactId>mockito-core</artifactId>
                <version>5.12.0</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <dependencies>
    <!-- 全仓统一测试台（parent <dependencies> 直供，所有子模块自动继承，
         子模块一律不再各自声明 junit；版本由根 DM / 地板 junit-bom 统一下发）：
           * junit-jupiter        — JUnit 5 新测试（API + 引擎）
           * junit-vintage-engine — 老 JUnit 4 测试（org.junit.Test）跑在 JUnit 5 平台上 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.vintage</groupId>
            <artifactId>junit-vintage-engine</artifactId>
            <scope>test</scope>
            <version>5.10.2</version>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <!-- 这两条**故意**留在本仓：parent 下发的是 compiler 3.11.0 / surefire 2.22.2（全组织的
                     保守尺），本仓从旧 parent 那侧一直用的是 3.13.0 / 3.2.5 —— 迁移前后两侧构建日志都是
                     `compiler:3.13.0:compile` + `surefire:3.2.5:test`，25 支用例的数量与 0 失败两侧一致。
                     换尺是另一个决定，不在"只换 parent"这一格里顺手做。
                     ⚠ 但 parent 的 `<compilerArgs>-parameters</compilerArgs>` 是**合并**进来的，挡不住：
                     实测 4 个模块 112 支 class 的 md5 全部变化（RouteMatcher.class 的 MethodParameters
                     属性 0 处 → 4 处），class 文件 major 仍是 52（Java 8 口径没漂）。 -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                    <configuration>
                        <source>8</source>
                        <target>8</target>
                        <encoding>${project.build.sourceEncoding}</encoding>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.2.5</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <!-- 常开（不挂 central profile）：挂 profile 时 `mvn install` 不带 -P central，
                 装进本地仓的 pom 仍然带着 com.zifang:z-opc:1.0.0-SNAPSHOT 这个永不存在的
                 parent ⇒ 本机消费者读到的还是废 pom。对照实测（同目录形状、只换 flatten 位置）：
                 挂 profile 一侧每个入库 pom 都带 <parent> 且聚合 pom 的 parent 悬空，常开一侧为 0。
                 版本钉 1.5.0：门禁机 250（Maven 3.6.0）实测 1.5.0 rc=0，
                 1.6.0/1.7.2 rc=1 “requires Maven version 3.6.3”。 -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>1.5.0</version>
                <inherited>true</inherited>
                <configuration>
                    <updatePomFile>true</updatePomFile>
                    <flattenMode>oss</flattenMode>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>flatten.clean</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>central</id>
            <properties>
                <maven.javadoc.skip>false</maven.javadoc.skip>
                <central.gpg.skip>false</central.gpg.skip>
            </properties>
            <distributionManagement>
                <repository>
                    <id>central</id>
                    <url>https://central.sonatype.com</url>
                </repository>
                <snapshotRepository>
                    <id>central</id>
                    <url>https://central.sonatype.com</url>
                </snapshotRepository>
            </distributionManagement>
            <build>
                <plugins>
                    <!-- 只放"发布才需要"的插件。flatten 不在这里——它已提到根 <build><plugins>
                         常开，因为挂在本 profile 上时 `mvn install` 装进本地仓的 pom 仍带着
                         悬空 parent。 -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-deploy-plugin</artifactId>
                        <version>3.1.4</version>
                        <configuration><skip>true</skip></configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.3.0</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals><goal>jar-no-fork</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.11.2</version>
                        <configuration>
                            <doclint>none</doclint>
                            <failOnError>false</failOnError>
                            <failOnWarnings>false</failOnWarnings>
                            <quiet>true</quiet>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <phase>verify</phase>
                                <goals><goal>jar</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.7</version>
                        <configuration>
                            <skip>${central.gpg.skip}</skip>
                            <gpgArguments>
                                <arg>--pinentry-mode</arg>
                                <arg>loopback</arg>
                                <arg>--no-tty</arg>
                            </gpgArguments>
                        </configuration>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals><goal>sign</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.8.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <tokenAuth>true</tokenAuth>
                            <autoPublish>true</autoPublish>
                            <!-- 本插件不认 maven.deploy.skip，没排除的模块照样进 bundle
                                 （实测结论见 z-schedule/pom.xml 同位置注释）⇒ 不可发布的模块点名列出。
                              · z-gw-admin：管理端可执行应用，只有主类 + 数据源配置，repackage 不带
                                  classifier ⇒ 产物是执行 fat jar，不是别仓可引的库件。 -->
                            <excludeArtifacts>
                                <excludeArtifact>z-gw-admin</excludeArtifact>
                            </excludeArtifacts>
                            <waitUntil>uploaded</waitUntil>
                            <waitMaxTime>1800</waitMaxTime>
                            <waitPollingInterval>10</waitPollingInterval>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>

