<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.yuku123</groupId>
        <artifactId>z-gw</artifactId>
        <version>1.0.6</version>
        
    </parent>
    <groupId>io.github.yuku123</groupId>
    <version>1.0.6</version>

    <artifactId>z-gw-core</artifactId>
    <packaging>jar</packaging>

    <name>z-gw :: core</name>
    <description>
        z-gw 核心引擎 — Netty 服务器、路由匹配(radixtree)、谓词工厂、过滤器工厂、
        5 种负载均衡、3 种限流、3 种熔断、服务发现、集群同步、HTTP 客户端。
        不依赖 Spring,以纯 Java 实现核心逻辑,spring-boot-starter 包装为 Spring 生态。
    </description>

    <url>https://github.com/yuku123/z-gw</url>
    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <developers>
        <developer>
            <id>yuku123</id>
            <name>yuku123</name>
            <email>1340947819@qq.com</email>
            <organization>z-team</organization>
            <organizationUrl>https://github.com/yuku123</organizationUrl>
            <timezone>+08:00</timezone>
            <roles>
                <role>owner</role>
            </roles>
        </developer>
    </developers>
    <scm>
        <connection>scm:git:https://github.com/yuku123/z-gw.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/yuku123/z-gw.git</developerConnection>
        <url>https://github.com/yuku123/z-gw</url>
        <tag>HEAD</tag>
    </scm>



    <dependencies>
        <!-- 内部依赖 -->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-gw-api</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Netty：原来这里钉的是字面 4.1.100.Final，而迁移前根 DM 的 netty-all 是 4.1.138.Final ⇒
             同一个 reactor 里 io.netty:netty-all 有两个版本（z-gw-core 编译用 4.1.100，
             starter/admin 打包用 4.1.138），且 netty-all 的传递模块被旧地板（1.0.17）压成 4.1.92.Final。
             删掉这行字面量、改由地板的 netty-bom 下发（4.1.138.Final），全仓收敛成同一格。 -->
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-all</artifactId>
        </dependency>

        <!-- Logging — 与 z-opc 统一 -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
            <version>2.25.4</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
            <version>2.25.4</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-slf4j2-impl</artifactId>
            <version>2.25.4</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>2.0.9</version>
        </dependency>

        <!-- z-util 工具库：版本由 parent 的 fleet 下发（1.0.13，与迁移前同值） -->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-util-core</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.apache.logging.log4j</groupId>
                    <artifactId>log4j-slf4j2-impl</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-util-parser-json</artifactId>
        </dependency>

        <!-- 仅测试期：z-util 抬到 1.2.2 后不再传递 Jackson，而本模块的 src/test
             （GatewayHandlerErrorResponseTest / GatewayHandlerNotFoundJsonTest）仍用
             ObjectMapper 解析响应体。测试源码本轮不迁，Jackson 只在 test 作用域显式留一份。 -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- 可观测性：版本由地板下发（原钉 1.12.13，2026-10-14 收回 1.9.17 地板，
             用到的 API 在地板版本上全都在，见根 pom 里的说明） -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-core</artifactId>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>5.12.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
