<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.zifang</groupId>
        <artifactId>z-gw</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        
    </parent>

    <artifactId>z-gw-admin</artifactId>
    <packaging>jar</packaging>

    <name>z-gw-admin</name>
    <description>
        z-gw 管理端 — 提供 /gw/admin/** 下的 REST API 用于动态 CRUD 路由、服务、集群节点。
        可独立部署,也可与 z-gw spring-boot-starter 同一进程内嵌。
    </description>

    <dependencies>
        <dependency>
            <groupId>com.zifang</groupId>
            <artifactId>z-gw-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.zifang</groupId>
            <artifactId>z-gw-spring-boot-starter</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Spring Web MVC 提供 @RestController 端点 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Knife4j API 文档 -->
        <dependency>
            <groupId>com.github.xiaoymin</groupId>
            <artifactId>knife4j-openapi3-spring-boot-starter</artifactId>
        </dependency>

        <!-- 校验 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
