<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.zifang</groupId>
        <artifactId>z-gw</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        
    </parent>

    <artifactId>z-gw-examples</artifactId>
    <packaging>jar</packaging>

    <name>z-gw-examples</name>
    <description>
        z-gw 示例启动器 — 单进程内置 z-gw + z-gw-admin,
        默认 :8888 提供管理 API, :9090 提供网关代理端口。
        一行启动即可演示完整功能。
    </description>

    <dependencies>
        <dependency>
            <groupId>com.zifang</groupId>
            <artifactId>z-gw-admin</artifactId>
        </dependency>

        <!-- 完整的 Spring Boot Web 用于管理 API -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
    </dependencies>

    <build>
        <finalName>z-gw-examples</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.zifang.z.gw.examples.GwExamplesApplication</mainClass>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
