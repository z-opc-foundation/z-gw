<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.yuku123</groupId>
        <artifactId>z-gw</artifactId>
        <version>1.0.1</version>
        
    </parent>
    <groupId>io.github.yuku123</groupId>
    <version>1.0.1</version>

    <artifactId>z-gw-examples</artifactId>
    <packaging>jar</packaging>

    <name>z-gw-examples</name>
    <description>
        z-gw 示例启动器 — 单进程内置 z-gw + z-gw-admin,
        默认 :8888 提供管理 API, :9090 提供网关代理端口。
        一行启动即可演示完整功能。
    </description>

    <url>https://github.com/yuku123/z-gw</url>
    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <developers>
        <developer>
            <id>yuku123</id>
            <name>yuku123</name>
            <email>1340947819@qq.com</email>
            <organization>z-team</organization>
            <organizationUrl>https://github.com/yuku123</organizationUrl>
            <timezone>+08:00</timezone>
            <roles>
                <role>owner</role>
            </roles>
        </developer>
    </developers>
    <scm>
        <connection>scm:git:https://github.com/yuku123/z-gw.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/yuku123/z-gw.git</developerConnection>
        <url>https://github.com/yuku123/z-gw</url>
        <tag>HEAD</tag>
    </scm>



    <dependencies>
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-gw-admin</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- 完整的 Spring Boot Web 用于管理 API -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <version>2.7.12</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
            <version>2.7.12</version>
        </dependency>
    </dependencies>

    <build>
        <finalName>z-gw-examples</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.zifang.z.gw.examples.GwExamplesApplication</mainClass>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
